{
  "name": "mantine-chat-ui",
  "version": "0.1.0",
  "description": "Chat UI for Mantine: an AG-UI chat panel with streaming, markdown, reasoning and message editing.",
  "license": "MIT",
  "author": "Yauhen Pyl",
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.ts",
  "module": "./dist/index.js",
  "scripts": {
    "dev": "vite",
    "build": "npm run build:lib && npm run build:demo",
    "build:lib": "vite build --config vite.lib.config.ts",
    "build:demo": "tsc -b && vite build",
    "prepublishOnly": "npm run build:lib",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "peerDependencies": {
    "@mantine/core": "^9.0.0",
    "@mantine/hooks": "^9.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "@ag-ui/client": "^1.0.3",
    "@ag-ui/core": "^1.0.3",
    "@tabler/icons-react": "^3.40.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/node": "^24.12.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "postcss": "^8.5.8",
    "postcss-preset-mantine": "^1.18.0",
    "postcss-simple-vars": "^7.0.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.57.0",
    "vite": "^8.0.1",
    "vite-plugin-dts": "^5.1.2",
    "wouter": "^3.9.0"
  },
  "keywords": [
    "mantine",
    "chat",
    "chat-ui",
    "ag-ui",
    "react",
    "streaming",
    "llm"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ypyl/chat-ui.git"
  },
  "publishConfig": {
    "access": "public"
  }
}
